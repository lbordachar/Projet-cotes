# Image officielle PHP 8.2 FPM (base Debian).
FROM php:8.2-fpm

# Dossier contenant le code de l'application.
WORKDIR /var/www/html

# 1. Installer curl et les certificats SSL pour les requetes HTTPS vers The Odds API.
# 2. Nettoyer le cache APT pour reduire la taille de l'image.
# 3. Installer le pilote MySQL pour PDO.
# 4. Activer la configuration PHP de production et masquer la version de PHP.
# 5. Creer un groupe et un utilisateur dedies sans privileges root (UID/GID 1000).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && docker-php-ext-install pdo_mysql \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && printf 'expose_php = Off\n' > "$PHP_INI_DIR/conf.d/security.ini" \
    && groupadd --gid 1000 appgroup \
    && useradd --uid 1000 --gid appgroup --create-home appuser

# Copier le code applicatif apres les dependances pour optimiser le cache de build Docker.
COPY --chown=appuser:appgroup api.php ./api.php

# Executer le service PHP-FPM avec le compte restreint non-root.
USER appuser

# Documenter le port d'ecoute FastCGI interne sans le publier sur l'hote.
EXPOSE 9000
